        </div>

        {formattedReport && (
          <div className="pt-4 border-t border-slate-800 flex items-center justify-between gap-2">
            <span className="text-[11px] text-slate-500">Salin ke Sistem Admin / WA</span>
            <button
              onClick={() => {
                navigator.clipboard.writeText(formattedReport);
                showToast('Laporan QC Disalin!');
              }}
              className="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs rounded-lg flex items-center gap-1.5 transition shadow"
            >
              <Copy className="w-3.5 h-3.5" />
              <span>Salin Laporan</span>
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

function ChecklistItem({ label, isOk, detail, onStatusChange, onDetailChange }) {
  return (
    <div
      className={`p-2.5 rounded-lg border transition-all ${
        isOk
          ? 'bg-slate-950/80 border-slate-800'
          : 'bg-amber-950/20 border-amber-500/40 shadow-sm'
      }`}
    >
      <div className="flex items-center justify-between gap-1">
        <span className="text-[10px] font-bold text-slate-300 uppercase tracking-tight truncate">
          {label}
        </span>
        {/* Toggle Buttons: Centang vs Silang */}
        <div className="flex items-center gap-1 bg-slate-900 p-0.5 rounded border border-slate-800">
          <button
            type="button"
            onClick={() => onStatusChange(true)}
            title="Status OK (Centang)"
            className={`px-2 py-0.5 rounded text-[10px] font-bold flex items-center gap-1 transition ${
              isOk
                ? 'bg-emerald-500 text-slate-950 shadow-sm'
                : 'text-slate-500 hover:text-slate-300'
            }`}
          >
            <Check className="w-3 h-3 stroke-[3]" />
            <span>OK</span>
          </button>
          <button
            type="button"
            onClick={() => onStatusChange(false)}
            title="Status Detail / Catatan (Silang)"
            className={`px-2 py-0.5 rounded text-[10px] font-bold flex items-center gap-1 transition ${
              !isOk
                ? 'bg-amber-500 text-slate-950 shadow-sm'
                : 'text-slate-500 hover:text-slate-300'
            }`}
          >
            <X className="w-3 h-3 stroke-[3]" />
            <span>Detail</span>
          </button>
        </div>
      </div>

      {/* Input detail box when status is NOT OK (Silang) */}
      {!isOk && (
        <div className="mt-2 animate-fadeIn">
          <input
            type="text"
            value={detail}
            onChange={(e) => onDetailChange(e.target.value)}
            placeholder="Tulis detail (misal: BH: 75%, OFF, -1 Kiri)..."
            className="w-full bg-slate-900 border border-amber-500/50 rounded px-2.5 py-1.5 text-amber-200 text-xs font-mono focus:outline-none focus:border-amber-400 placeholder:text-amber-700/60"
          />
        </div>
      )}
    </div>
  );
}

// ==========================================
// MODULE 4: INTERACTIVE AI ASSISTANT & KNOWLEDGE BASE
// ==========================================
function ModuleAiAssistant({ showToast }) {
  const [messages, setMessages] = useState([
    {
      sender: 'ai',
      text: 'Halo Teknisi Internasional Komputer! Saya AI Assistant khusus perbaikan motherboard & hardware. Silakan tanyakan hal teknis seperti pengukuran jalur, kode error BIOS, atau fungsi sinyal sirkuit.'
    }
  ]);
  const [inputQuery, setInputQuery] = useState('');
  const [isSending, setIsSending] = useState(false);
  const chatEndRef = useRef(null);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  const handleSendMessage = async (textToSend) => {
    const query = textToSend || inputQuery;
    if (!query.trim()) return;

    const newMessages = [...messages, { sender: 'user', text: query }];
    setMessages(newMessages);
    if (!textToSend) setInputQuery('');
    setIsSending(true);

    try {
      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: `Act as a senior laptop hardware repair engineer for Internasional Komputer. Answer clearly and technically in Indonesian: ${query}` }] }]
        })
      });

      if (response.ok) {
        const data = await response.json();
        const replyText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (replyText) {
          setMessages([...newMessages, { sender: 'ai', text: replyText }]);
          setIsSending(false);
          return;
        }
      }
    } catch (err) {
      console.warn('Chat AI fallback triggered:', err);
    }

    // Fallback response generator
    setTimeout(() => {
      let mockReply = 'Berikut penjelasannya berdasarkan kriteria servis motherboard:\n\n';
      if (query.toLowerCase().includes('resistansi') || query.toLowerCase().includes('3vs')) {
        mockReply += '1. **Nilai Normal Jalur +3VS:** Umumnya berkisar antara 300 Ohm hingga beberapa Kilo-Ohm (skala dioda ~0.350V).\n2. **Tanda Short:** Jika resistansi di bawah 10 Ohm, dipastikan ada komponen busuk (kapasitor SMD short atau chip audio/LAN terintegrasi rusak).\n3. **Saran:** Gunakan metode injeksi tegangan 1.0V DC (maks 2A) untuk melacak komponen yang panas.';
      } else if (query.toLowerCase().includes('rsmrst')) {
        mockReply += 'Sinyal **RSMRST# (Resume Reset)** dihasilkan oleh IC KBC/EC (misal: IT8586E / NPCE285) ke PCH setelah tegangan standby 3.3V & 5V stabil. Jika RSMRST# 0V, PCH tidak akan mengeluarkan sinyal penolakan sleep SLP_S3#.';
      } else {
        mockReply += 'Untuk penanganan masalah ini, pastikan terlebih dahulu tegangan input utama (VIN 19V) tidak bocor pada gate MOSFET pertama. Lakukan cek resistansi multimeter skala dioda ke ground pada semua induktor sekunder sebelum menghubungkan adaptor.';
      }

      setMessages([...newMessages, { sender: 'ai', text: mockReply }]);
      setIsSending(false);
    }, 1000);
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {/* Knowledge Glossary Cards */}
      <div className="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4 shadow-xl">
        <div className="flex items-center gap-2 pb-3 border-b border-slate-800">
          <BookOpen className="w-5 h-5 text-cyan-400" />
          <h2 className="font-bold text-white text-base">Glosarium Sinyal Motherboard</h2>
        </div>

        <p className="text-xs text-slate-400">
          Klik sinyal di bawah ini untuk menanyakan penjelasan lengkap ke Asisten AI:
        </p>

        <div className="space-y-2.5 max-h-[480px] overflow-y-auto pr-1">
          {SIGNAL_GLOSSARY.map((item, idx) => (
            <div
              key={idx}
              onClick={() => handleSendMessage(`Jelaskan fungsi sinyal ${item.name} dan cara ukurnya dengan multimeter?`)}
              className="p-3 bg-slate-950 border border-slate-800 hover:border-cyan-500/50 rounded-lg cursor-pointer transition group"
            >
              <div className="flex justify-between items-center">
                <span className="font-mono text-xs font-bold text-cyan-400 group-hover:text-cyan-300">
                  {item.name}
                </span>
                <ChevronRight className="w-3.5 h-3.5 text-slate-600 group-hover:text-cyan-400 transition" />
              </div>
              <p className="text-[11px] text-slate-400 mt-1 line-clamp-2">{item.def}</p>
            </div>
          ))}
        </div>
      </div>

      {/* AI Chat Interactive Panel */}
      <div className="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-xl p-5 flex flex-col justify-between h-[600px] shadow-xl">
        <div className="flex items-center justify-between pb-3 border-b border-slate-800">
          <div className="flex items-center gap-2">
            <Sparkles className="w-5 h-5 text-cyan-400" />
            <div>
              <h3 className="font-bold text-white text-sm">Konsultasi AI Teknisi Motherboard</h3>
              <p className="text-[10px] text-slate-400">Powered by Gemini 3 Flash Technical Logic</p>
            </div>
          </div>
          <button
            onClick={() => setMessages([messages[0]])}
            className="text-[11px] text-slate-400 hover:text-slate-200"
          >
            Bersihkan Chat
          </button>
        </div>

        {/* Message History */}
        <div className="flex-1 overflow-y-auto my-4 space-y-3 pr-2">
          {messages.map((m, idx) => (
            <div
              key={idx}
              className={`flex ${m.sender === 'user' ? 'justify-end' : 'justify-start'}`}
            >
              <div
                className={`max-w-[85%] p-3.5 rounded-xl text-xs leading-relaxed whitespace-pre-wrap ${
                  m.sender === 'user'
                    ? 'bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-br-none shadow'
                    : 'bg-slate-950 border border-slate-800 text-slate-200 rounded-bl-none font-sans'
                }`}
              >
                {m.text}
              </div>
            </div>
          ))}
          {isSending && (
            <div className="flex justify-start">
              <div className="bg-slate-950 border border-slate-800 text-slate-400 text-xs p-3 rounded-xl flex items-center gap-2">
                <RefreshCw className="w-3.5 h-3.5 animate-spin text-cyan-400" />
                <span>AI sedang berpikir &amp; menganalisis...</span>
              </div>
            </div>
          )}
          <div ref={chatEndRef} />
        </div>

        {/* Input Bar */}
        <div className="pt-3 border-t border-slate-800 flex gap-2">
          <input
            type="text"
            value={inputQuery}
            onChange={(e) => setInputQuery(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && handleSendMessage()}
            placeholder="Ketik pertanyaan teknis (misal: Cara cek IC Power short?)..."
            className="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-cyan-500 font-sans"
          />
          <button
            onClick={() => handleSendMessage()}
            disabled={isSending || !inputQuery.trim()}
            className="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-lg flex items-center gap-1.5 text-xs transition disabled:opacity-50"
          >
            <Send className="w-3.5 h-3.5" />
            <span>Kirim</span>
          </button>
        </div>
      </div>
    </div>
  );
}
