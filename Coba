// ==========================================
// MODULE 1: POWER RAIL & VOLTAGE SEQUENCE ANALYZER
// ==========================================
function ModulePowerRailDiagnostics({ onDiagnoseComplete, showToast }) {
  const [boardModel, setBoardModel] = useState('Lenovo NM-D031');
  const [symptom, setSymptom] = useState('power_drop');
  const [voltages, setVoltages] = useState({
    vin19v: true,
    alw3v5v: true,
    vs3v: false,
    vs5v: false,
    rsmrst: true,
    slps3: false,
    vccCore: false
  });
  const [customNotes, setCustomNotes] = useState('Short diduga di beban sekunder 3VS setelah di-switch.');
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [analysisResult, setAnalysisResult] = useState(null);

  const toggleVoltage = (key) => {
    setVoltages((prev) => ({ ...prev, [key]: !prev[key] }));
  };

  const handleAnalyze = async () => {
    setIsAnalyzing(true);
    setAnalysisResult(null);

    const promptText = `
Act as a Master Laptop Motherboard Repair Specialist at Internasional Komputer.
Analyze the following motherboard measurement data:
- Motherboard Code: ${boardModel}
- Symptom / Gejala: ${symptom}
- Multitester Measurement Status:
  * 19V VIN Main Input: ${voltages.vin19v ? 'HADIR (19V Normal)' : 'HILANG (0V / Short Protection)'}
  * +3VALW / +5VALW Always-On: ${voltages.alw3v5v ? 'HADIR (3.3V/5.0V Normal)' : 'HILANG'}
  * +3VS Sekunder: ${voltages.vs3v ? 'HADIR' : 'HILANG (0V / Drop)'}
  * +5VS Sekunder: ${voltages.vs5v ? 'HADIR' : 'HILANG (0V / Drop)'}
  * RSMRST# (EC to PCH): ${voltages.rsmrst ? 'HADIR (3.3V High)' : 'LOW (0V)'}
  * SLP_S3# (PCH State): ${voltages.slps3 ? 'HADIR (3.3V High)' : 'LOW (0V)'}
  * VCC_CORE (CPU Power): ${voltages.vccCore ? 'HADIR' : 'HILANG'}
- Catatan Tambahan Teknisi: ${customNotes}

Please provide a structured technical breakdown in INDONESIAN:
1. AKAR MASALAH & ANALISIS SIRKUIT (Ringkas & logis)
2. DICURIGAI KOMPONEN RUSAK (Sebutkan komponen umum seperti Mosfet Transfer U32/PQ301, IC Stepdown, Cap Short, atau PCH)
3. URUTAN PENGETESAN/TINDAKAN BERIKUTNYA (Injeksi tegangan MVI, ukur resistansi multimeter mode dioda, cek sinyal EN).
`;

    try {
      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: promptText }] }]
        })
      });

      if (response.ok) {
        const data = await response.json();
        const generatedText =
          data?.candidates?.[0]?.content?.parts?.[0]?.text || null;

        if (generatedText) {
          setAnalysisResult({
            aiOutput: generatedText,
            timestamp: new Date().toLocaleTimeString('id-ID')
          });
          setIsAnalyzing(false);
          onDiagnoseComplete();
          showToast('Analisis AI Jalur Daya Selesai!');
          return;
        }
      }
    } catch (err) {
      console.warn('API call fallback triggered due to error/offline:', err);
    }

    // Fallback simulation logic
    setTimeout(() => {
      const fallbackText = `
### ⚡ ANALISIS JALUR DAYA - ${boardModel.toUpperCase()}

#### 1. AKAR MASALAH & ANALISIS SIRKUIT
- **Kondisi:** Tegangan 19V VIN dan +3VALW/+5VALW hadir normal, namun sinyal SLP_S3# LOW dan jalur +3VS/+5VS hilang saat di-switch.
- **Logika Sirkuit:** Jalur standby dalam kondisi baik. Kegagalan terjadi pada perpindahan state dari S5 (Standby) ke S3 (Active). Karena RSMRST# hadir (3.3V), KBC telah mengirim perintah reset ke PCH, tetapi PCH belum membalas dengan sinyal pembuka SLP_S3#.

#### 2. KOMPONEN DICURIGAI (SUSPECT COMPONENTS)
1. **MOSFET Transfer / Switch 3VS (Misal: PQ301 / U32 / AON7408):** Mengalami short ke ground atau bocor pada gate.
2. **Kapasitor Filter SMD (Jalur 3VS):** Sering short mengakibatkan proteksi beban berlebih (Over-Current Protection).
3. **PCH Power State / KBC Firmware (EC BIOS):** Corrupt atau terbakar sebagian pada pin SLP_S3#.

#### 3. URUTAN TANDAKAN / INJEKSI TEGANGAN (MVI)
1. **Ukur Resistansi Ke Ground (Skala Dioda Multimeter):**
   - Ukur kaki Induktor/Pad 3VS. Jika resistansi di bawah 10 Ohm, dipastikan ada short sirkuit pada beban.
2. **Injeksi Tegangan Terkendali (Micro Voltage Injection):**
   - Atur Power Supply ke **1.0V DC (Current Limit 2A)** pada jalur 3VS.
   - Rabut board / gunakan Thermal Camera untuk menemukan komponen SMD yang panas.
3. **Cek Resistor Pull-up SLP_S3#:** Pastikan resistor pull-up 10K ke +3V3_DSW tidak open/putus.
`;

      setAnalysisResult({
        aiOutput: fallbackText,
        timestamp: new Date().toLocaleTimeString('id-ID')
      });
      setIsAnalyzing(false);
      onDiagnoseComplete();
      showToast('Analisis Diagnostik Siap!');
    }, 1200);
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {/* Form Input Section */}
      <div className="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-5 shadow-xl">
        <div className="flex items-center justify-between pb-3 border-b border-slate-800">
          <div className="flex items-center gap-2">
            <Zap className="w-5 h-5 text-cyan-400" />
            <h2 className="font-bold text-white text-base">Input Pengukuran Hardware</h2>
          </div>
          <button
            onClick={() => {
              setBoardModel('Toshiba Satellite C600 (Inventec BR10ML)');
              setSymptom('mati_total');
              setVoltages({
                vin19v: true,
                alw3v5v: true,
                vs3v: false,
                vs5v: true,
                rsmrst: true,
                slps3: true,
                vccCore: false
              });
              setCustomNotes('Gejala: Mati total / Power drop protection.\nHasil Ukur Awal: Missing 3VS voltage rails, 19V normal.');
            }}
            className="text-[11px] text-cyan-400 hover:underline flex items-center gap-1 text-right"
          >
            <RefreshCw className="w-3 h-3" /> Load Contoh Kasus:<br/>Missing 3VS
          </button>
        </div>

        {/* Kode Motherboard */}
        <div className="space-y-1.5">
          <label className="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Kode Motherboard / Model
          </label>
          <input
            type="text"
            value={boardModel}
            onChange={(e) => setBoardModel(e.target.value)}
            placeholder="Contoh: Compal LA-H111P, NM-D031"
            className="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-cyan-500 font-mono"
          />
        </div>

        {/* Gejala Kerusakan */}
        <div className="space-y-1.5">
          <label className="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Gejala Kerusakan Utama
          </label>
          <select
            value={symptom}
            onChange={(e) => setSymptom(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-cyan-500"
          >
            <option value="power_drop">Power Drop / On Sebentar Lalu Off (Protection Active)</option>
            <option value="mati_total">Mati Total (0A / No Current Draw)</option>
            <option value="no_display">Mesin Nyala (Fan Spinning) Tapi No Display</option>
            <option value="short_vin">Short 19V VIN Main Rail (Power Supply Short/Beep)</option>
            <option value="no_charge">Tidak Bisa Charge Baterai / Adapter Drop</option>
          </select>
        </div>

        {/* Checklist Tegangan & Sinyal (Multitester) */}
        <div className="space-y-2">
          <div className="flex justify-between items-center">
            <label className="text-xs font-semibold text-slate-300 uppercase tracking-wider">
              Status Tegangan / Sinyal (Multimeter)
            </label>
            <span className="text-[10px] text-cyan-400">Klik untuk Toggle Status</span>
          </div>

          <div className="grid grid-cols-2 gap-2 text-xs">
            <VoltageToggle
              label="19V VIN Main"
              active={voltages.vin19v}
              onClick={() => toggleVoltage('vin19v')}
            />
            <VoltageToggle
              label="+3VALW / +5VALW"
              active={voltages.alw3v5v}
              onClick={() => toggleVoltage('alw3v5v')}
            />
            <VoltageToggle
              label="+3VS Sekunder"
              active={voltages.vs3v}
              onClick={() => toggleVoltage('vs3v')}
            />
            <VoltageToggle
              label="+5VS Sekunder"
              active={voltages.vs5v}
              onClick={() => toggleVoltage('vs5v')}
            />
            <VoltageToggle
              label="RSMRST# (3.3V)"
              active={voltages.rsmrst}
              onClick={() => toggleVoltage('rsmrst')}
            />
            <VoltageToggle
              label="SLP_S3# (PCH)"
              active={voltages.slps3}
              onClick={() => toggleVoltage('slps3')}
            />
            <VoltageToggle
              label="VCC_CORE (CPU)"
              active={voltages.vccCore}
              onClick={() => toggleVoltage('vccCore')}
            />
          </div>
        </div>

        {/* Catatan Tambahan Teknisi */}
        <div className="space-y-1.5">
          <label className="text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Catatan Observasi Fisik / Tambahan
          </label>
          <textarea
            rows={3}
            value={customNotes}
            onChange={(e) => setCustomNotes(e.target.value)}
            placeholder="Misal: Ditemukan bekas korosi dekat IC Charger, atau komponen membal saat disolder..."
            className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-100 focus:outline-none focus:border-cyan-500"
          ></textarea>
        </div>

        {/* Analyze Action Button */}
        <button
          onClick={handleAnalyze}
          disabled={isAnalyzing}
          className="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-500/25 disabled:opacity-50"
        >
          {isAnalyzing ? (
            <>
              <RefreshCw className="w-4 h-4 animate-spin" />
              <span>Menganalisis Sirkuit via AI...</span>
            </>
          ) : (
            <>
              <Sparkles className="w-4 h-4" />
              <span>Analisis Jalur Daya dengan AI</span>
            </>
          )}
        </button>
      </div>

      {/* Output Result Section */}
      <div className="lg:col-span-7 space-y-4">
        {/* Interactive Block Diagram Card */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3">
          <div className="flex justify-between items-center">
            <h3 className="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
              <Layers className="w-4 h-4 text-cyan-400" />
              Power Sequence Map ({boardModel})
            </h3>
            <span className="text-[10px] text-slate-400">Arsitektur Jalur Daya Standard</span>
          </div>

          <div className="grid grid-cols-4 sm:grid-cols-7 gap-1.5 text-center text-[10px] font-mono">
            <DiagramNode label="VIN (19V)" active={voltages.vin19v} />
            <DiagramNode label="3V/5VALW" active={voltages.alw3v5v} />
            <DiagramNode label="RSMRST#" active={voltages.rsmrst} />
            <DiagramNode label="SLP_S3#" active={voltages.slps3} />
            <DiagramNode label="+3VS/+5VS" active={voltages.vs3v && voltages.vs5v} />
            <DiagramNode label="VCC_CORE" active={voltages.vccCore} />
            <DiagramNode label="DISPLAY" active={voltages.vccCore} isEnd />
          </div>
        </div>

        {/* AI Diagnostic Output */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 min-h-[400px] flex flex-col justify-between">
          <div>
            <div className="flex justify-between items-center pb-3 border-b border-slate-800">
              <div className="flex items-center gap-2">
                <Terminal className="w-5 h-5 text-emerald-400" />
                <h3 className="font-bold text-white text-sm">Hasil Diagnostik &amp; Rekomendasi AI</h3>
              </div>
              {analysisResult && (
                <span className="text-[10px] text-slate-400 font-mono">
                  Selesai pukul: {analysisResult.timestamp}
                </span>
              )}
            </div>

            {analysisResult ? (
              <div className="mt-4 text-xs leading-relaxed text-slate-200 font-sans whitespace-pre-line space-y-3">
                {analysisResult.aiOutput}
              </div>
            ) : (
              <div className="flex flex-col items-center justify-center py-20 text-center text-slate-500 space-y-3">
                <Activity className="w-12 h-12 text-slate-800 animate-pulse" />
                <p className="text-xs max-w-sm">
                  Isi parameter multimeter di sebelah kiri lalu klik tombol <strong className="text-cyan-400">Analisis Jalur Daya</strong> untuk melihat panduan perbaikan AI.
                </p>
              </div>
            )}
          </div>

          {analysisResult && (
            <div className="pt-4 mt-4 border-t border-slate-800 flex justify-end gap-2">
              <button
