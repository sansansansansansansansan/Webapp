<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechAssist AI - Workbench Teknisi Internasional Komputer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & React DOM UMD -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    <!-- Babel Standalone -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen">
    <div id="root"></div>

    <script type="text/babel">
        const { useState } = React;

        function App() {
            const [activeTab, setActiveTab] = useState('qc');
            
            // State Modul 3: QC Checklist
            const [ssd, setSsd] = useState('100');
            const [hdd, setHdd] = useState('');
            const [battery, setBattery] = useState('75');
            const [ram, setRam] = useState('8 GB');
            const [serviceId, setServiceId] = useState('SERV-2026-1108');
            const [customerName, setCustomerName] = useState('Pelanggan Toko');
            const [unitModel, setUnitModel] = useState('Laptop Lenovo / Asus');

            const [checklist, setChecklist] = useState({
                Casing: { isOk: true, detail: '' },
                Bitlocker: { isOk: false, detail: 'OFF' },
                Keyboard: { isOk: true, detail: '' },
                Touchpad: { isOk: true, detail: '' },
                Camera: { isOk: true, detail: '' },
                Microphone: { isOk: true, detail: '' },
                'Wifi/Bluetooth': { isOk: true, detail: '' },
                Layar: { isOk: true, detail: '' },
                Speaker: { isOk: true, detail: '' },
                Baut: { isOk: true, detail: '' },
                USB: { isOk: false, detail: '-1 (Paling kiri)' },
                Cleaning: { isOk: true, detail: '' },
                Aktivasi: { isOk: true, detail: '' }
            });

            // Modul 1: Power Rail State
            const [boardModel, setBoardModel] = useState('Lenovo NM-D031');
            const [symptom, setSymptom] = useState('power_drop');
            const [powerOutput, setPowerOutput] = useState('');

            // Modul 2: BSOD State
            const [stopCode, setStopCode] = useState('WHEA_UNCORRECTABLE_ERROR (0x00000124)');
            const [bsodOutput, setBsodOutput] = useState('');

            const handleToggle = (key, isOkVal) => {
                setChecklist(prev => ({
                    ...prev,
                    [key]: { ...prev[key], isOk: isOkVal }
                }));
            };

            const handleDetailChange = (key, text) => {
                setChecklist(prev => ({
                    ...prev,
                    [key]: { ...prev[key], detail: text }
                }));
            };

            const setAllOk = () => {
                setSsd('100');
                setHdd('100');
                setBattery('100');
                setRam('8 GB');
                const newChecklist = {};
                Object.keys(checklist).forEach(key => {
                    newChecklist[key] = { isOk: true, detail: '' };
                });
                setChecklist(newChecklist);
            };

            const loadExample = () => {
                setSsd('100');
                setHdd('');
                setBattery('75');
                setRam('8 GB');
                setChecklist({
                    Casing: { isOk: true, detail: '' },
                    Bitlocker: { isOk: false, detail: 'OFF' },
                    Keyboard: { isOk: true, detail: '' },
                    Touchpad: { isOk: true, detail: '' },
                    Camera: { isOk: true, detail: '' },
                    Microphone: { isOk: true, detail: '' },
                    'Wifi/Bluetooth': { isOk: true, detail: '' },
                    Layar: { isOk: true, detail: '' },
                    Speaker: { isOk: true, detail: '' },
                    Baut: { isOk: true, detail: '' },
                    USB: { isOk: false, detail: '-1 (Paling kiri)' },
                    Cleaning: { isOk: true, detail: '' },
                    Aktivasi: { isOk: true, detail: '' }
                });
            };

            const generateReport = () => {
                let report = `==================================================\n`;
                report += `   INTERNASIONAL KOMPUTER - LAPORAN SERVIS & QC\n`;
                report += `==================================================\n`;
                report += `NO. NOTA / ID : ${serviceId}\n`;
                report += `PELANGGAN     : ${customerName}\n`;
                report += `TIPE LAPTOP   : ${unitModel}\n`;
                report += `--------------------------------------------------\n`;
                report += `[${ssd === '100' ? '✓' : '✗'}] SSD           : ${ssd ? ssd + '%' : '-'}\n`;
                report += `[${hdd === '100' ? '✓' : (hdd ? '✗' : '-')}] HDD           : ${hdd ? hdd + '%' : 'Tidak Ada'}\n`;
                report += `[✓] RAM           : ${ram || 'Tidak diisi'}\n`;
                report += `[${battery === '100' ? '✓' : '✗'}] Battery Health : ${battery ? battery + '%' : '-'}\n`;

                Object.keys(checklist).forEach(key => {
                    const item = checklist[key];
                    const symbol = item.isOk ? '✓' : '✗';
                    const detailText = item.isOk ? 'OK' : (item.detail || 'CATATAN');
                    report += `[${symbol}] ${key.padEnd(14, ' ')} : ${detailText}\n`;
                });
                report += `==================================================\n`;
                
                navigator.clipboard.writeText(report);
                alert("Laporan QC Berhasil Disalin ke Clipboard!\n\n" + report);
            };

            const handleAnalyzePower = () => {
                setPowerOutput(`⚡ ANALISIS JALUR DAYA (${boardModel})
--------------------------------------------------
1. AKAR MASALAH: Drop tegangan pada sirkuit +3VS sekunder setelah di-switch.
2. SUSPECT KOMPONEN: MOSFET Transfer PQ301 / U32 atau Kapasitor SMD short ke ground.
3. REKOMENDASI TINDAKAN: Injeksi tegangan 1.0V DC (Limit 2A) di jalur +3VS untuk mencari titik panas.`);
            };

            const handleAnalyzeBsod = () => {
                setBsodOutput(`🖥️ ANALISIS BSOD (${stopCode})
--------------------------------------------------
1. KATEGORI: Hardware Instability / VRAM Voltage Drop.
2. ISOLASI: Pengujian beban GPU memicu crash driver nvlddmkm.sys.
3. SOLUSI: Perawatan thermal paste, pembersihan radiator, dan reinstall driver GPU via DDU.`);
            };

            return (
                <div className="max-w-5xl mx-auto p-4 md:p-6 space-y-6">
                    {/* Header */}
                    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <div className="flex items-center gap-2">
                                <h1 className="text-2xl font-bold text-white tracking-tight">
                                    Internasional Komputer <span className="text-cyan-400">TechAssist AI</span>
                                </h1>
                                <span className="text-[10px] bg-cyan-950 text-cyan-400 border border-cyan-800 px-2.5 py-0.5 rounded-full font-bold uppercase">v3.0 Workbench</span>
                            </div>
                            <p className="text-xs text-slate-400 mt-1">Workbench & System Diagnostik Hardware Teknisi</p>
                        </div>
                        <div className="flex gap-2">
                            <span className="text-xs bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-lg text-emerald-400 font-semibold flex items-center gap-1.5">
                                <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Mode Lokal Active
                            </span>
                        </div>
                    </div>

                    {/* Navigasi Tab */}
                    <div className="flex overflow-x-auto gap-2 border-b border-slate-800 pb-3">
                        <button onClick={() => setActiveTab('power')} className={`px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition flex items-center gap-2 ${activeTab === 'power' ? 'bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/20' : 'bg-slate-900 text-slate-400 hover:text-white'}`}>
                            1. Power Rail
                        </button>
                        <button onClick={() => setActiveTab('bsod')} className={`px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition flex items-center gap-2 ${activeTab === 'bsod' ? 'bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/20' : 'bg-slate-900 text-slate-400 hover:text-white'}`}>
                            2. Analisis BSOD
                        </button>
                        <button onClick={() => setActiveTab('qc')} className={`px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition flex items-center gap-2 ${activeTab === 'qc' ? 'bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/20' : 'bg-slate-900 text-slate-400 hover:text-white'}`}>
                            3. QC Checklist & Service Log
                        </button>
                    </div>

                    {/* TAB 3: QC CHECKLIST */}
                    {activeTab === 'qc' && (
                        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                            <div className="lg:col-span-7 bg-slate-900 border border-slate-800 p-5 rounded-2xl shadow-xl space-y-4">
                                <div className="flex justify-between items-center pb-3 border-b border-slate-800">
                                    <h2 className="font-bold text-white text-base">Checklist Add Value (QC)</h2>
                                    <div className="flex gap-2">
                                        <button onClick={loadExample} className="text-xs bg-slate-800 hover:bg-slate-700 text-cyan-400 font-semibold px-3 py-1.5 rounded-lg border border-slate-700 transition">📄 Sample Lembar Kertas</button>
                                        <button onClick={setAllOk} className="text-xs bg-slate-800 hover:bg-slate-700 text-emerald-400 font-semibold px-3 py-1.5 rounded-lg border border-slate-700 transition">✅ Set Semua OK</button>
                                    </div>
                                </div>

                                <div className="grid grid-cols-3 gap-2 text-xs">
                                    <div>
                                        <label className="text-[10px] text-slate-400 uppercase font-semibold">No. Service</label>
                                        <input type="text" value={serviceId} onChange={e => setServiceId(e.target.value)} className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1 focus:outline-none focus:border-cyan-500" />
                                    </div>
                                    <div>
                                        <label className="text-[10px] text-slate-400 uppercase font-semibold">Pelanggan</label>
                                        <input type="text" value={customerName} onChange={e => setCustomerName(e.target.value)} className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1 focus:outline-none focus:border-cyan-500" />
                                    </div>
                                    <div>
                                        <label className="text-[10px] text-slate-400 uppercase font-semibold">Model Laptop</label>
                                        <input type="text" value={unitModel} onChange={e => setUnitModel(e.target.value)} className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white mt-1 focus:outline-none focus:border-cyan-500" />
                                    </div>
                                </div>

                                <div className="space-y-3 pt-2">
                                    {/* SSD Row */}
                                    <div className="flex flex-col sm:flex-row sm:items-center justify-between p-2.5 bg-slate-950 rounded-lg border border-slate-800 gap-2">
                                        <span className="font-semibold text-xs text-slate-300 w-32">SSD (%)</span>
                                        <div className="flex items-center gap-2 flex-1">
                                            <input type="number" value={ssd} onChange={e => setSsd(e.target.value)} placeholder="Misal: 100" className="bg-slate-900 border border-slate-700 p-1.5 rounded w-28 text-xs text-white focus:outline-none focus:border-cyan-500" />
                                            {ssd === '100' ? <span className="text-emerald-400 text-xs font-bold bg-emerald-950 border border-emerald-800 px-2 py-0.5 rounded">✓ OK</span> : (ssd ? <span className="text-amber-400 text-xs font-bold bg-amber-950 border border-amber-800 px-2 py-0.5 rounded">✗ Cek</span> : null)}
                                        </div>
                                    </div>

                                    {/* HDD Row */}
                                    <div className="flex flex-col sm:flex-row sm:items-center justify-between p-2.5 bg-slate-950 rounded-lg border border-slate-800 gap-2">
                                        <span className="font-semibold text-xs text-slate-300 w-32">HDD (%)</span>
                                        <div className="flex items-center gap-2 flex-1">
                                            <input type="number" value={hdd} onChange={e => setHdd(e.target.value)} placeholder="Kosongkan jika tdk ada" className="bg-slate-900 border border-slate-700 p-1.5 rounded w-44 text-xs text-white focus:outline-none focus:border-cyan-500" />
                                            {hdd === '100' ? <span className="text-emerald-400 text-xs font-bold bg-emerald-950 border border-emerald-800 px-2 py-0.5 rounded">✓ OK</span> : (hdd ? <span className="text-amber-400 text-xs font-bold bg-amber-950 border border-amber-800 px-2 py-0.5 rounded">✗ Cek</span> : null)}
                                        </div>
                                    </div>

                                    {/* Battery Row */}
                                    <div className="flex flex-col sm:flex-row sm:items-center justify-between p-2.5 bg-slate-950 rounded-lg border border-slate-800 gap-2">
                                        <span className="font-semibold text-xs text-slate-300 w-32">Battery Health (%)</span>
                                        <div className="flex items-center gap-2 flex-1">
                                            <input type="number" value={battery} onChange={e => setBattery(e.target.value)} placeholder="Misal: 75" className="bg-slate-900 border border-slate-700 p-1.5 rounded w-28 text-xs text-white focus:outline-none focus:border-cyan-500" />
                                            {battery && <span className="text-cyan-400 text-xs font-semibold">BH: {battery}%</span>}
                                        </div>
                                    </div>

                                    {/* RAM Row */}
                                    <div className="flex flex-col sm:flex-row sm:items-center justify-between p-2.5 bg-slate-950 rounded-lg border border-slate-800 gap-2">
                                        <span className="font-semibold text-xs text-slate-300 w-32">Kapasitas RAM</span>
                                        <div className="flex-1">
                                            <input type="text" value={ram} onChange={e => setRam(e.target.value)} placeholder="Tulis kapasitas RAM (Misal: 8GB)" className="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-xs text-white focus:outline-none focus:border-cyan-500" />
                                        </div>
                                    </div>

                                    <hr className="border-slate-800 my-3" />

                                    {/* Item Toggle List */}
                                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                        {Object.keys(checklist).map(key => {
                                            const item = checklist[key];
                                            return (
                                                <div key={key} className={`p-2.5 rounded-lg border transition ${item.isOk ? 'bg-slate-950 border-slate-800' : 'bg-amber-950/20 border-amber-500/40'}`}>
                                                    <div className="flex justify-between items-center">
                                                        <span className="text-xs font-bold text-slate-200">{key}</span>
                                                        <div className="flex gap-1 bg-slate-900 p-0.5 rounded border border-slate-800">
                                                            <button onClick={() => handleToggle(key, true)} className={`px-2 py-0.5 text-[10px] font-bold rounded ${item.isOk ? 'bg-emerald-500 text-slate-950' : 'text-slate-500'}`}>✓ OK</button>
                                                            <button onClick={() => handleToggle(key, false)} className={`px-2 py-0.5 text-[10px] font-bold rounded ${!item.isOk ? 'bg-amber-500 text-slate-950' : 'text-slate-500'}`}>✗ Silang</button>
                                                        </div>
                                                    </div>
                                                    {!item.isOk && (
                                                        <input type="text" value={item.detail} onChange={e => handleDetailChange(key, e.target.value)} placeholder={`Keterangan ${key}...`} className="mt-2 w-full bg-slate-900 border border-amber-500/40 p-1.5 rounded text-xs text-amber-200 focus:outline-none focus:border-amber-400" />
                                                    )}
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>

                                <button onClick={generateReport} className="w-full mt-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold py-3 rounded-xl transition text-sm shadow-lg shadow-cyan-500/20">
                                    📋 Salin Format Laporan QC
                                </button>
                            </div>

                            <div className="lg:col-span-5 bg-slate-900 border border-slate-800 p-5 rounded-2xl shadow-xl flex flex-col justify-between">
                                <div>
                                    <h3 className="font-bold text-white text-sm pb-3 border-b border-slate-800">Panduan Penggunaan Lokal</h3>
                                    <div className="mt-4 text-xs text-slate-300 space-y-3 leading-relaxed">
                                        <p>1. <strong>Input SSD/HDD:</strong> Ketik <code className="text-cyan-400">100</code> untuk otomatis centang OK.</p>
                                        <p>2. <strong>Input Baterai & RAM:</strong> Masukkan angka persentase baterai dan teks kapasitas RAM langsung tanpa ceklis.</p>
                                        <p>3. <strong>Checklist Tambahan:</strong> Pilih <span className="text-emerald-400 font-bold">✓ OK</span> atau <span className="text-amber-400 font-bold">✗ Silang</span>. Jika disilang, masukkan catatan fisik seperti pada kertas checklist toko.</p>
                                        <p>4. <strong>Format Otomatis:</strong> Klik tombol biru di bawah untuk menyalin teks format servis yang siap dikirim ke admin / WhatsApp pelanggan.</p>
                                    </div>
                                </div>
                                <div className="mt-6 p-3 bg-slate-950 border border-slate-800 rounded-xl text-[11px] text-slate-400">
                                    Internasional Komputer — Standar Operasional Belajar AI Divisi Teknisi
                                </div>
                            </div>
                        </div>
                    )}

                    {/* TAB 1: POWER RAIL */}
                    {activeTab === 'power' && (
                        <div className="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4">
                            <h2 className="font-bold text-white text-lg">1. Troubleshooting Power Rail</h2>
                            <p className="text-xs text-slate-400">Modul analisis urutan tegangan motherboard (19V, 3VALW, 3VS, RSMRST#, SLP_S3#).</p>
                            <div className="flex gap-2">
                                <input type="text" value={boardModel} onChange={e => setBoardModel(e.target.value)} placeholder="Kode Board" className="bg-slate-950 border border-slate-800 p-2 rounded text-xs text-white" />
                                <button onClick={handleAnalyzePower} className="bg-cyan-500 text-slate-950 font-bold px-4 py-2 rounded text-xs">Analisis Sirkuit</button>
                            </div>
                            {powerOutput && (
                                <pre className="p-4 bg-slate-950 border border-slate-800 rounded-xl text-xs text-cyan-300 font-mono whitespace-pre-wrap">{powerOutput}</pre>
                            )}
                        </div>
                    )}

                    {/* TAB 2: BSOD */}
                    {activeTab === 'bsod' && (
                        <div className="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4">
                            <h2 className="font-bold text-white text-lg">2. Analisis Blue Screen (BSOD)</h2>
                            <p className="text-xs text-slate-400">Modul analisis Stop Code & Log Error Windows.</p>
                            <div className="flex gap-2">
                                <input type="text" value={stopCode} onChange={e => setStopCode(e.target.value)} placeholder="Stop Code" className="bg-slate-950 border border-slate-800 p-2 rounded text-xs text-white" />
                                <button onClick={handleAnalyzeBsod} className="bg-cyan-500 text-slate-950 font-bold px-4 py-2 rounded text-xs">Analisis BSOD</button>
                            </div>
                            {bsodOutput && (
                                <pre className="p-4 bg-slate-950 border border-slate-800 rounded-xl text-xs text-cyan-300 font-mono whitespace-pre-wrap">{bsodOutput}</pre>
                            )}
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
